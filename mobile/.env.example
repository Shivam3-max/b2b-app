# Copy to .env and fill in. All values are public (shipped inside the app), never put admin keys here.
EXPO_PUBLIC_SHOPIFY_DOMAIN=aub1my-11.myshopify.com
EXPO_PUBLIC_SHOPIFY_API_VERSION=2025-07
# From Shopify admin > Sales channels > Headless > Storefront API > public access token (optional).
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# The deployed B2B Store app server, e.g. https://b2bstore-app-server.vercel.app
EXPO_PUBLIC_API_URL=
